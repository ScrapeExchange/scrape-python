###
### Scrape.Exchange settings (shared by all tools)
###

# Base URL for the Scrape.Exchange API
# EXCHANGE_URL=https://scrape.exchange

# API key ID for authenticating with the Scrape.Exchange API
API_KEY_ID=<your API key ID>

# API key secret for authenticating with the Scrape.Exchange API
API_KEY_SECRET=<your API key secret>

# Logging level for tools that have no scraper-specific override
# LOG_LEVEL=INFO

# Log file path for tools that have no scraper-specific override
# LOG_FILE=/dev/stdout

# Log record format: "json" (structured) or "text"
# LOG_FORMAT=json

# Redis connection string for cross-host rate-limiter coordination and
# shared scraper state (queues, identity maps, no-feeds, uploaded video
# IDs). When set, the Redis backend is preferred over the shared-file
# backend, and scrapers can run on multiple hosts without exceeding
# rate limits.
# REDIS_DSN=redis://localhost:6379/0
# Maximum Redis connections per logical client/pool. Most tools create
# several named pools per worker process; keep this small unless a
# measured Redis bottleneck says otherwise.
# REDIS_MAX_CONNECTIONS=4

# Comma-separated list of files; each line is a proxy URL
# (http://host:port[:user:pass] or http://user:pass@host:port) or a
# local egress IP (local://x.x.x.x). Proxies are optional.
# PROXY_FILES=

# Proxy CIDRs help Grafana group results per CIDR instead of individual
# proxies. Comma-separated.
# PROXY_NETWORKS=

###
### File locations (shared by YouTube scraper and upload tools)
###

# Directory where scraped channel-*.json.br files are written.
# In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# YOUTUBE_CHANNEL_DATA_DIR=/data/channels

# Directory where scraped video-min-*.json.br files are written.
# In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# YOUTUBE_VIDEO_DATA_DIR=/data/videos

# Sub-directory of YOUTUBE_VIDEO_DATA_DIR (or absolute path) where the
# RSS scraper drops newly-discovered video ID stubs for the video
# scraper to pick up ahead of the bulk archive backlog
# YOUTUBE_VIDEO_PRIORITY_DIRECTORY=

# Sub-directory of YOUTUBE_CHANNEL_DATA_DIR (or absolute path) where
# the RSS scraper writes lite channel-stat records for upload to
# scrape.exchange
# YOUTUBE_CHANNEL_PRIORITY_DIRECTORY=priority

###
### Bulk upload tuning (used by tools/scrape_upload.py)
###

# Maximum number of records sent per bulk-upload POST. The byte cap
# bulk_max_batch_bytes is applied alongside; whichever cap is hit first
# finalises the batch.
# BULK_BATCH_SIZE=1000

# Soft byte cap for one bulk-upload batch. Stays under the bulk
# endpoint server-side 8 GB limit with headroom for multipart framing.
# BULK_MAX_BATCH_BYTES=7516192768

# Maximum seconds to wait on the bulk-upload progress WebSocket for a
# terminal status before giving up. Source files are left in base_dir
# for the next run.
# BULK_PROGRESS_TIMEOUT=1800

# Maximum number of accepted bulk-upload jobs tracked in the local
# .bulk state directory that may be in flight at once. New batches
# block at this ceiling until one pending job reaches a terminal
# result and is reconciled.
# MAX_ACTIVE_BULK_JOBS=10

###
### RSS circuit breaker (shared by all YouTube scraper tools — guards
### against the YouTube WAF's 404 burst window)
###

# F: number of 404s in the last T attempts on previously-scraped
# channels that trips the RSS circuit.
# RSS_CIRCUIT_FAIL_THRESHOLD=8

# T: size of the rolling attempt window evaluated against the
# fail threshold.
# RSS_CIRCUIT_WINDOW_SIZE=10

# S: initial cooldown in seconds when the RSS circuit first trips.
# RSS_CIRCUIT_INITIAL_OPEN_SECONDS=60

# Ceiling for the doubled S in impaired mode (2 h by default).
# RSS_CIRCUIT_MAX_OPEN_SECONDS=7200

# C: consecutive 404s while in impaired-closed that re-open the
# circuit at the doubled cooldown.
# RSS_CIRCUIT_IMPAIRED_REOPEN_THRESHOLD=3

# N: consecutive successes while in impaired-closed that return the
# circuit to regular mode.
# RSS_CIRCUIT_RECOVERY_THRESHOLD=50

# Maximum random jitter (seconds) added to every circuit-breaker wait.
# Spreads worker wake-ups so only one probe leaks per recovery window.
# RSS_CIRCUIT_WAIT_JITTER_SECONDS=30.0

###
### InnerTube / HTML / RSS rate-limiter refill rates (shared by all
### YouTube scrapers — token-bucket refill per proxy per minute).
### Defined in scrape_exchange/youtube/rate_limit_settings.py and
### loaded once at module import (changes need a restart).
### Burst caps are intentionally not tunable — see the docstring
### on YouTubeRateLimitSettings for the 2026-05-09 SYN-flood
### diagnosis that lowered them.
###

# Refill rate for InnerTube `browse` calls, in requests per minute
# per proxy. Used by the channel scraper (tab walks) and the RSS
# scraper (channel-stat refresh).
# BROWSE_REFILL_PER_MIN=150

# Refill rate for InnerTube `player` calls, in requests per minute
# per proxy. Used by the RSS scraper (per-video enrichment) and the
# video scraper (per-video full scrape). Raised from 10 to 30/min
# on 2026-05-12 after diagnosing the prior cap saturated workers
# with 9.5s p95 sleep and drained the keep-alive pool.
# PLAYER_REFILL_PER_MIN=30

# Refill rate for InnerTube `next` calls, in requests per minute
# per proxy. Used by the RSS scraper and the video scraper for
# per-video metadata.
# NEXT_REFILL_PER_MIN=150

# Refill rate for HTML (channel /about page) calls, in requests
# per minute per proxy. Used by the channel scraper. Intentionally
# very low because the HTML path triggers the YouTube anti-bot WAF
# at higher rates.
# HTML_REFILL_PER_MIN=9

# Refill rate for RSS XML-feed fetches, in requests per minute per
# proxy. Used by the RSS scraper. Raised from 9.6 to 30/min on
# 2026-05-12 after diagnosing 3.6s p95 sleep was draining the
# keep-alive pool.
# RSS_REFILL_PER_MIN=30

###
### TikTok rate limits (shared by TikTok creator/video scrapers).
### Token-bucket refill rates are per proxy per minute. Creator and
### video scraping use separate TikTokApi data-call buckets, so creator
### scraping can be throttled independently from video scraping. The
### bootstrap bucket remains shared because session creation and
### ms_token refreshes have the same Camoufox/TikTokApi pressure.
###

# Backwards-compatible fallback refill rate for TikTokApi data calls,
# in requests per minute per proxy. Used when TIKTOK_CREATOR_RPM or
# TIKTOK_VIDEO_RPM are unset, and by legacy callers that still acquire
# the shared "api" bucket.
# TIKTOK_GLOBAL_RPM=6.0

# Refill rate for TikTok creator API data calls, in requests per
# minute per proxy. Applies to tt_creator_scrape.py and appears in
# Grafana/Prometheus rate-limit metrics as api="creator_api".
# TIKTOK_CREATOR_RPM=6.0

# Refill rate for TikTok video API data calls, in requests per minute
# per proxy. Applies to tt_video_scrape.py and appears in
# Grafana/Prometheus rate-limit metrics as api="video_api".
# TIKTOK_VIDEO_RPM=6.0

# Refill rate for TikTok session bootstrap and ms_token refresh calls,
# in requests per minute per proxy. Appears in Grafana/Prometheus
# rate-limit metrics as api="bootstrap".
# TIKTOK_BOOTSTRAP_RPM=6.0

# Floor on the next-check delay after a TikTok creator scrape hits
# bot-detection or a rate-limit response, in seconds.
# TIKTOK_CREATOR_RATE_LIMIT_RETRY_INTERVAL=1800.0

###
### TikTok creator queue (tools/tt_creator_scrape.py)
###

# Priority tiers for the Redis-backed TikTok creator scrape queue.
# Format is comma-separated interval_hours:min_followers, highest
# priority first; the final catch-all tier must end in :0.
# TIKTOK_CREATOR_PRIORITY_QUEUES=168:1000000,336:100000,720:10000,4320:0

# Seconds before a creator claim held by a crashed worker expires and
# can be recovered by queue housekeeping.
# TIKTOK_CREATOR_CLAIM_TTL=600

# Sleep ceiling, in seconds, between empty/delayed creator queue polls.
# TIKTOK_CREATOR_QUEUE_IDLE_POLL=30.0

# Floor on the next-check delay after a transient creator scrape
# failure, in seconds.
# TIKTOK_CREATOR_RETRY_INTERVAL=300.0

# Random +/- fraction applied to creator retry delays so failed
# creators do not all become due at the same instant.
# TIKTOK_CREATOR_RETRY_JITTER_FRACTION=0.25

###
### TikTok file locations
###

# Directory where scraped TikTok creator records are written.
# In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# TIKTOK_CREATOR_DATA_DIR=/data/tiktok/creators

# Directory where scraped TikTok video records are written.
# In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# TIKTOK_VIDEO_DATA_DIR=/data/tiktok/videos

# Directory where TikTok browser session state and ms_token state are
# persisted. In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# TIKTOK_SESSION_STATE_DIR=/data/tiktok/session-state

###
### TikTok log files
###

# Log file path for the TikTok creator scraper. In Docker Compose,
# set this to the mounted scraper log directory so
# Filebeat/Elasticsearch can pick up current tt*.log files.
# TIKTOK_CREATOR_LOG_FILE=/var/log/scrape/scraper/tt_creator.log

# Log file path for the TikTok video scraper.
# TIKTOK_VIDEO_LOG_FILE=/var/log/scrape/scraper/tt_video.log

###
### Instagram rate limits (shared by Instagram scrapers).
### Token-bucket refill rates are per proxy per minute. The global
### fallback is used only when the more specific setting is unset.
###

# Backwards-compatible fallback refill rate for Instagram browser calls,
# in requests per minute per proxy.
# IG_GLOBAL_RPM=

# Refill rate for Instagram creator profile page fetches, in requests
# per minute per proxy.
# IG_CREATOR_RPM=1.0

# Refill rate for Instagram browser session bootstrap calls, in
# requests per minute per proxy.
# IG_BOOTSTRAP_RPM=2.0

###
### Instagram creator scraper (tools/ig_creator_scrape.py)
###

# Number of child Instagram creator scraper processes to spawn. When
# > 1 the invocation becomes a supervisor that splits the proxy pool
# into N disjoint chunks and spawns one child per chunk.
# IG_CREATOR_NUM_PROCESSES=1

# Fleet-wide async worker upper bound. When set to 0, the scraper uses
# one worker per configured proxy.
# IG_CREATOR_CONCURRENCY=0

# Ignore configured proxies and scrape through a direct browser session.
# IG_CREATOR_DISABLE_PROXIES=false

# Logging level for the Instagram creator scraper. Falls back to
# LOG_LEVEL when unset.
# IG_CREATOR_LOG_LEVEL=INFO

# Log file path for the Instagram creator scraper. Falls back to
# LOG_FILE when unset. In Docker Compose, set this to the mounted
# scraper log directory so Filebeat/Elasticsearch can pick it up.
# IG_CREATOR_LOG_FILE=/var/log/scrape/scraper/ig_creator.log

# Port for the Prometheus metrics HTTP server. Actual ports used are
# from base to base + <num_processes> (base reserved for supervisor).
# IG_CREATOR_METRICS_PORT=9400

# Priority tiers for the Redis-backed Instagram creator scrape queue.
# Format is comma-separated interval_hours:min_followers, highest
# priority first; the final catch-all tier must end in :0.
# IG_CREATOR_PRIORITY_QUEUES=72:10000000,168:1000000,336:100000,720:10000,4320:0

# Seconds before a creator claim held by a crashed worker expires and
# can be recovered by queue housekeeping.
# IG_CREATOR_CLAIM_TTL=600

# Sleep ceiling, in seconds, between empty/delayed creator queue polls.
# IG_CREATOR_QUEUE_IDLE_POLL=30.0

# Interval, in seconds, between queue orphan recovery scans.
# IG_CREATOR_ORPHAN_RECOVERY_INTERVAL=600.0

# Floor on the next-check delay after a transient creator scrape
# failure, in seconds.
# IG_CREATOR_RETRY_INTERVAL=300.0

# Floor on the next-check delay after an Instagram block/rate-limit
# page, in seconds.
# IG_CREATOR_RATE_LIMIT_RETRY_INTERVAL=1800.0

# Floor on the next-check delay when follower_count is not available,
# in seconds.
# IG_CREATOR_UNKNOWN_FOLLOWERS_RETRY_INTERVAL=86400.0

# Random +/- fraction applied to creator retry delays so failed
# creators do not all become due at the same instant.
# IG_CREATOR_RETRY_JITTER_FRACTION=0.25

# Consecutive block/rate-limit signals before the proxy session is
# quarantined and rebuilt.
# IG_CREATOR_BOT_FAILURE_THRESHOLD=1

# Initial cooldown, in seconds, after a bot-detected proxy session.
# IG_CREATOR_BOT_COOLDOWN=1800.0

# Maximum exponential bot-detection cooldown, in seconds.
# IG_CREATOR_BOT_COOLDOWN_MAX=3600.0

# Milliseconds to wait for Instagram browser session bootstrap.
# IG_SESSION_BOOTSTRAP_TIMEOUT=90000

###
### Instagram file locations
###

# Directory where scraped Instagram creator records are written.
# In Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# IG_CREATOR_DATA_DIR=/data/instagram/creators

# Directory where Instagram browser session state is persisted. In
# Docker Compose, this is the container path mounted by
# docker-compose.override.yml.
# IG_SESSION_STATE_DIR=/data/instagram/session-state

###
### Twitch creator scraper (tools/tw_creator_scrape.py)
### Anonymous public profiles; no Twitch or Exchange credentials needed.
### See docs/twitch-creator-scraper.md for setup and queue commands.
###

# directory for twitch-creator-{username}.json.br records.
# TWITCH_CREATOR_DATA_DIR=/data/twitch/creators

# Number of worker processes. A supervisor divides the proxy pool into
# disjoint slices when this is greater than one.
# TWITCH_CREATOR_NUM_PROCESSES=1

# Total async tasks across worker processes, capped by available proxies.
# Direct access uses one task. Unlike Instagram, zero is not supported.
# TWITCH_CREATOR_CONCURRENCY=1

# Ignore shared PROXIES/PROXY_FILES settings and use direct access.
# TWITCH_CREATOR_DISABLE_PROXIES=false

# Per-proxy refill rates per minute: profile navigations, website
# profile HTTP requests, and browser starts respectively.
# TWITCH_CREATOR_RPM=2.0
# TWITCH_DATA_RPM=60.0
# TWITCH_BOOTSTRAP_RPM=2.0

# Refresh tiers: interval_hours:min_followers, highest priority first.
# Missing follower counts retain the current tier; they are not zero.
# TWITCH_CREATOR_PRIORITY_QUEUES=24:1000000,72:100000,168:10000,336:0

# Claim lifetime in seconds. Must exceed the profile timeout by more
# than 60 seconds to allow file writes and queue bookkeeping.
# TWITCH_CREATOR_CLAIM_TTL_SECONDS=300

# Idle queue polling and orphan recovery intervals, in seconds.
# TWITCH_CREATOR_QUEUE_IDLE_POLL_SECONDS=30.0
# TWITCH_CREATOR_ORPHAN_RECOVERY_INTERVAL_SECONDS=300.0

# Retry delay for transient/extraction failures, before added jitter.
# TWITCH_CREATOR_RETRY_INTERVAL_SECONDS=300.0

# Initial and maximum exponential cooldown after blocked requests.
# TWITCH_CREATOR_BOT_COOLDOWN_SECONDS=1800.0
# TWITCH_CREATOR_BOT_COOLDOWN_MAX_SECONDS=7200.0

# Overall profile deadline and post-navigation data wait, in seconds.
# TWITCH_CREATOR_PROFILE_TIMEOUT_SECONDS=60.0
# TWITCH_CREATOR_DATA_WAIT_SECONDS=15.0

# Browser startup deadline, in seconds.
# TWITCH_SESSION_BOOTSTRAP_TIMEOUT_SECONDS=90.0

# Logging and Prometheus configuration. The shared supervisor handles
# multiprocess metric collection when worker processes are enabled.
# TWITCH_CREATOR_LOG_LEVEL=INFO
# TWITCH_CREATOR_LOG_FILE=/dev/stdout
# TWITCH_CREATOR_METRICS_PORT=9910

###
### Generic scrape upload worker
###

# Upload every configured scraper data directory above. The worker
# derives platform/entity targets from YOUTUBE_*, TIKTOK_*, and IG_*
# data-directory settings.
# SCRAPE_UPLOAD_MODE=bulk
# SCRAPE_UPLOAD_WATCH=true
# SCRAPE_UPLOAD_CONCURRENCY=3
# SCRAPE_UPLOAD_LOG_FILE=/var/log/scrape/scrape_upload.log

###
### HTTP timeouts (shared by all YouTube scrapers — connect vs
### request budget per scraper). Defined in
### scrape_exchange/http_timeouts.py and loaded once at module
### import (changes need a restart). Resolves automatically per
### tool based on the script name.
###

# TCP + CONNECT + TLS handshake budget for an RSS-scraper HTTPS
# request (RSS XML fetches and the InnerTube enrichment calls
# the RSS scraper makes), in seconds.
# RSS_CONNECT_TIMEOUT=5.0

# Read + write + pool budget for an RSS-scraper HTTPS request,
# in seconds.
# RSS_REQUEST_TIMEOUT=30.0

# TCP + CONNECT + TLS handshake budget for a channel-scraper
# HTTPS request (InnerTube browse + HTML /about), in seconds.
# CHANNEL_CONNECT_TIMEOUT=5.0

# Read + write + pool budget for a channel-scraper HTTPS request,
# in seconds.
# CHANNEL_REQUEST_TIMEOUT=10.0

# TCP + CONNECT + TLS handshake budget for a video-scraper HTTPS
# request, in seconds.
# VIDEO_CONNECT_TIMEOUT=5.0

# Read + write + pool budget for a video-scraper HTTPS request,
# in seconds.
# VIDEO_REQUEST_TIMEOUT=10.0

###
### Channel scraper (tools/yt_channel_scrape.py)
###

# Number of child channel scraper processes to spawn. When > 1 the
# invocation becomes a supervisor that splits the proxy pool into N
# disjoint chunks and spawns one child per chunk.
# CHANNEL_NUM_PROCESSES=1

# Number of channels to scrape concurrently inside one process.
# Clamped to 1 when no proxies are configured.
# CHANNEL_CONCURRENCY=3

# Logging level for the channel scraper. Falls back to LOG_LEVEL when
# unset.
# CHANNEL_LOG_LEVEL=INFO

# Log file path for the channel scraper. Falls back to LOG_FILE when
# unset.
# CHANNEL_LOG_FILE=/dev/stdout

# Port for the Prometheus metrics HTTP server. Actual ports used are
# from base to base + <num_processes> (base reserved for supervisor).
# CHANNEL_METRICS_PORT=9600

# Maximum number of new channels to scrape in this run. Channels that
# have already been scraped or marked as not found are not counted.
# MAX_NEW_CHANNELS=1000

# Maximum number of channels with channel-ids for which we try to
# resolve the channel handle.
# MAX_RESOLVED_CHANNELS=100

# Path to a newline-delimited list of channel handles already uploaded
# to scrape.exchange. Channels in this list are skipped before being
# scheduled for scraping.
# YOUTUBE_UPLOADED_CHANNELS_LIST=/data/uploaded_channels.lst

# Comma-separated tier spec "interval_days:min_subscribers", highest
# priority first. -1 in the interval means drop the channel after one
# successful scrape. The last tier must have min_subscribers=0.
# CHANNEL_PRIORITY_QUEUES=7:1000000,30:100000,90:10000,180:1000,365:0

# Number of channel_ids the worker pops from the resolve queue per batch
# CHANNEL_QUEUE_RESOLVE_BATCH=25

# Deprecated: scheduled channel scraping now uses continuously refilled
# worker slots. This setting is ignored by yt_channel_scrape.py.
# CHANNEL_QUEUE_SCRAPE_BATCH=50

# Seconds between priority-directory drain cycles in the
# Redis-driven channel scraper. Runs only on worker_id=1.
# CHANNEL_PRIORITY_DRAIN_INTERVAL_SECONDS=60

# Seconds the worker sleeps between empty-queue polls before retrying
# CHANNEL_QUEUE_IDLE_POLL_SECONDS=2.0

# Max attempts to resolve a channel_id -> handle before giving up
# CHANNEL_RESOLVE_MAX_ATTEMPTS=5

# Seconds to wait before retrying a failed channel_id resolution
# CHANNEL_RESOLVE_BACKOFF_SECONDS=300

# Consecutive "unavailable" responses after which a channel is treated
# as hard-failed instead of soft-retried
# CHANNEL_UNAVAILABLE_HARD_THRESHOLD=3

# Seconds before a soft-unavailable channel is re-tried (default 24 h)
# CHANNEL_UNAVAILABLE_SOFT_RETRY_SECONDS=86400

# Interval (seconds) between soft-unavailable reap sweeps
# CHANNEL_SOFT_REAP_INTERVAL_SECONDS=60

###
### RSS scraper (tools/yt_rss_scrape.py)
###

# Number of child RSS scraper processes to spawn. When > 1 the
# invocation becomes a supervisor that splits the proxy pool.
# RSS_NUM_PROCESSES=1

# Number of channels to fetch in parallel inside one process.
# RSS_CONCURRENCY=3

# Logging level for the RSS scraper. Falls back to LOG_LEVEL when unset.
# RSS_LOG_LEVEL=INFO

# Log file path for the RSS scraper. Falls back to LOG_FILE when unset.
# RSS_LOG_FILE=/dev/stdout

# Port for the Prometheus metrics HTTP server. Actual ports used are
# from base to base + <num_processes> (base reserved for supervisor).
# RSS_METRICS_PORT=9500

# Run the startup pass that GETs subscriber counts from scrape.exchange
# for every channel not already in the Redis "known_creator_ids" set.
# Useful only for first-time setup or post-recovery — serialises ~80k
# API GETs and blocks the scrape loop for many minutes.
# RSS_ENRICH_SUBSCRIBER_COUNTS=false

# Walk the uploaded-channel directory at startup and enqueue any
# channels not already in the Redis queue. Useful only for first-time
# setup, post-flush recovery, or fleet rebuilds — multi-tens-of-minutes
# of work per worker on every restart.
# RSS_SEED_QUEUE_FROM_UPLOADED=false

# Consecutive RSS 404 failures before a channel is skipped. A single
# successful RSS fetch clears the counter.
# RSS_MAX_NO_FEED_FAILURES=10

# Higher 404-failure threshold for channels that have previously served
# at least one successful RSS feed (avoids losing established channels
# to transient YouTube soft-bans).
# RSS_MAX_NO_FEED_FAILURES_HAD_FEED=50

# Fraction of the tier interval after which a channel becomes eligible
# to be RSS-fetched again. < 1.0 introduces headroom so the SLA panel
# can report on-time fetches.
# RSS_ELIGIBILITY_FRACTION=0.5

# RSS-only override for PROXY_FILES. When set, the RSS scraper loads
# its proxy catalog from this list instead of PROXY_FILES, while video
# and channel scrapers keep the inherited list. Use this to exclude
# networks that YouTube has RSS-banned but still serves for HTML and
# InnerTube.
# RSS_PROXY_FILES=

# Minimum seconds between RSS polls per channel
# MIN_CHANNEL_INTERVAL_SECONDS=1800

# Minimum seconds before a failed channel is polled again. Applied as
# a floor on top of the tier interval.
# RETRY_INTERVAL_SECONDS=14400

# Comma-separated interval_hours:min_subscribers pairs defining
# priority tiers, ordered by priority (first = highest).
# RSS_PRIORITY_QUEUES=1:10_000_000,4:1_000_000,12:100_000,72:10_000,168:0

###
### Video scraper (tools/yt_video_scrape.py)
###

# Number of child video scraper processes to spawn. When > 1 the
# invocation becomes a supervisor that splits the proxy pool. Use this
# to bypass the GIL/ThreadPoolExecutor caps when yt-dlp is enabled.
# VIDEO_NUM_PROCESSES=1

# Number of videos to scrape concurrently inside one process.
# VIDEO_CONCURRENCY=3

# Logging level for the video scraper. Falls back to LOG_LEVEL when
# unset.
# VIDEO_LOG_LEVEL=INFO

# Log file path for the video scraper. Falls back to LOG_FILE when
# unset.
# VIDEO_LOG_FILE=/dev/stdout

# Port for the Prometheus metrics HTTP server. Actual ports used are
# from base to base + <num_processes> (base reserved for supervisor).
# VIDEO_METRICS_PORT=9400

# When True, run yt-dlp after the InnerTube pass to fetch the metadata
# yt-dlp adds on top (formats, availability, heatmaps, ...). When False
# only the InnerTube pass runs, trading completeness for throughput.
# VIDEO_USE_YT_DLP=false

# Path to the Deno executable (used by yt-dlp signature decryption)
# DENO_PATH=~/.deno/bin/deno

# URL for the PO token service used for InnerTube authentication
# PO_TOKEN_URL=http://localhost:4416

# Directory yt-dlp uses for its on-disk cache (player JS, signature
# decryption artefacts). Created at start if it does not exist.
# YTDLP_CACHE_DIR=/var/tmp/yt_dlp_cache

# Number of video ids the worker pops from the Redis video scrape
# queue per batch
# VIDEO_QUEUE_BATCH=50

# Seconds the worker sleeps between empty-queue polls before retrying
# VIDEO_QUEUE_IDLE_POLL_SECONDS=2.0

# Maximum number of attempts for a video that hits a transient failure
# before it is marked FAILED
# VIDEO_TRANSIENT_MAX_ATTEMPTS=3

# Seconds the worker waits before retrying a video that hit a
# transient failure
# VIDEO_TRANSIENT_BACKOFF_SECONDS=30

###
### Channel discovery tool (tools/yt_discover_channels.py)
###

# Output JSONL file for discovered channels
# YOUTUBE_DISCOVERED_CHANNELS=discovered-channels.jsonl

# Output JSONL file for failed scrapes
# YOUTUBE_FAILED_CHANNELS=failed-channels.jsonl

# Minimum subscriber count to keep a discovered channel
# MIN_SUBS=100

# Skip channels whose handle is already in the creator_map. Useful for
# resumed runs that aim to discover new channels rather than refresh
# known ones.
# YOUTUBE_SKIP_KNOWN_CREATORS=true

###
### 3rd-party data import (tools/yt_import_3rdparty_data.py)
###

# Kaggle dataset slugs (owner/name) or full dataset URLs to download
# and import. Set the env var to a JSON list.
# KAGGLE_DATASETS=

# Local cache directory for kagglehub downloads. Exported as
# KAGGLEHUB_CACHE so kagglehub reads and writes there.
# KAGGLE_CACHE_DIR=~/.cache/kaggle

# Hugging Face dataset repo IDs (org/name) to download via
# huggingface_hub.snapshot_download and import. Set the env var to a
# JSON list. Empty by default — opt-in.
# HF_DATASETS=

# Local cache directory for huggingface_hub downloads. Exported as
# HF_HUB_CACHE so huggingface_hub reads and writes there.
# HF_CACHE_DIR=~/.cache/huggingface/hub

# Ad-hoc single Kaggle dataset to process (slug or URL). When set, the
# configured defaults in kaggle_datasets AND hf_datasets are skipped —
# only the ad-hoc selection runs.
# KAGGLE_DATASET=

# Ad-hoc single Hugging Face dataset (repo ID org/name) to process.
# Same precedence as KAGGLE_DATASET: when either ad-hoc flag is set,
# both default lists are skipped.
# HF_DATASET=

# Manual override: when set, skip the Kaggle download step and import
# this single file directly. Format detected from the suffix (.csv,
# .jsonl/.ndjson, .parquet).
# CSV_FILE=

###
### File-backend-only settings — only consulted when REDIS_DSN is unset.
### Several functionalities (priority queues, identity maps, no-feeds set)
### are unavailable in file-backend mode, so these settings only cover the
### shared filesystem used for channel coordination (queues, identity maps,
### no-feeds set, rate-limiter).
###

# Directory for cross-process rate-limiter state. Token buckets are
# persisted per proxy and every process on this host that shares the
# proxy pool converges on one view of per-proxy rate limits. Must be on
# a local filesystem (not NFS/CIFS/SSHFS). Set to "" to disable shared
# state and fall back to per-process buckets. Ignored when REDIS_DSN
# is set (the Redis-backed limiter takes over).
# RATE_LIMITER_STATE_DIR=/tmp/scrape_exchange

# Newline-delimited list of channel handles/IDs to scrape. Only read
# by the deprecated file-based channel-scraper path (`scrape_channels`,
# marked DEPRECATED in tools/yt_channel_scrape.py). When REDIS_DSN is
# set, channels enter via tools/yt_channel_queue.py and this file is
# unused.
# YOUTUBE_CHANNEL_LIST=channels.lst

# CSV file capturing channel_id -> channel_handle mappings, used by
# FileCreatorMap. Ignored when REDIS_DSN is set (the shared
# youtube:creator_map hash is used instead).
# YOUTUBE_CHANNEL_MAP_FILE=channel_map.csv

# Path to JSON file for persisting the RSS channel queue. Only used by
# FileCreatorQueue when REDIS_DSN is unset; ignored otherwise.
# RSS_QUEUE_FILE=yt-rss-reader-queue.json

# Path to text file where channel ids with missing RSS feeds are logged
# (one per line). Only used by the file backend; ignored when REDIS_DSN
# is set.
# NO_FEEDS_FILE=yt-rss-reader-no-feeds.txt

# Path to file persisting the set of channel ids that have ever
# successfully served an RSS feed. Used to decide which 404 threshold
# applies to a given channel. File backend only — ignored when
# REDIS_DSN is set.
# HAD_FEED_FILE=yt-rss-reader-had-feed.txt
